NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Generate a unique random value with at least 32 characters.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
# SMTP credentials are optional until password recovery is enabled.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Clientora <your-email@example.com>
APP_URL=https://clientora.app
# Optional: set the first platform administrator's local user ID separately
# after creating the account. Do not use an external identity-provider ID.
