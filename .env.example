NODE_ENV=production
PORT=3000
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Generate a unique random value with at least 32 characters.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=https://clientora.app

# S3-compatible object storage (required for image/file uploads).
S3_ENDPOINT=https://your-object-storage-endpoint
S3_REGION=auto
S3_BUCKET=clientora-files
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=false

# SMTP is optional until password recovery emails are enabled.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=Clientora <your-email@example.com>
